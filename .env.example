# Copy this file to `.env` and fill in your key.
# `.env` is read automatically at startup (see app/config.py).
# A real environment variable always overrides whatever is written here.
#
# NEVER commit or submit your filled-in `.env` — the API key is a password.

# --- environment -----------------------------------------------------------
APP_ENV=dev

# --- storage ---------------------------------------------------------------
# Required outside APP_ENV=test. The app refuses to start without it.
# Leave commented out if you are only running the tests or the smoke script.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/registration

# --- providers -------------------------------------------------------------
# Free key: https://developer.company-information.service.gov.uk/
# Create an application, then create a REST key (not OAuth2).
COMPANIES_HOUSE_API_KEY=

# GLEIF needs no credentials.
GLEIF_BASE=https://api.gleif.org/api/v1

# OpenCorporates API key (optional for basic queries, recommended for high volume)
OPENCORPORATES_BASE=https://api.opencorporates.com/v0.4
OPENCORPORATES_API_KEY=

# --- lifecycle -------------------------------------------------------------
CONSENSUS_TTL_SECONDS=86400
RAW_TTL_SECONDS=172800
PURGE_INTERVAL_SECONDS=300

# --- continuous ingestion --------------------------------------------------
# The poller re-fetches every watched query on this interval, with no HTTP
# traffic required. Seed it with "country|company_name|registration_number"
# entries separated by semicolons.
REFRESH_INTERVAL_SECONDS=900
WATCHLIST_MAX=50
WATCHLIST=GB|Barclays Bank UK PLC|;GB|Monzo Bank Limited|09446231;PK|Habib Bank Limited|

# --- serving ---------------------------------------------------------------
RATE_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
UPSTREAM_TIMEOUT_SECONDS=4.0
VERIFIED_CONFIDENCE_THRESHOLD=0.75
